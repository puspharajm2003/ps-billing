{
  "name": "smr-groups-billing",
  "version": "1.0.0",
  "description": "SMR Groups Billing Software — Unified launcher for backend and frontend",
  "main": "main.js",
  "scripts": {
    "dev": "node start.js",
    "build": "node start.js --build",
    "backend": "cd backend && npx ts-node src/index.ts",
    "frontend": "cd frontend && npm run dev",
    "build:all": "cd frontend && npm run build && cd ../backend && npm run build",
    "electron:start": "electron .",
    "electron:pack": "npm run build:all && electron-builder --dir",
    "electron:dist": "npm run build:all && electron-builder"
  },
  "build": {
    "appId": "com.smrgroups.billing",
    "productName": "SMR Groups Billing",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "puspharajm2003",
      "repo": "ps-billing"
    },
    "files": [
      "main.js",
      "backend/dist/**/*",
      "backend/package.json",
      "frontend/dist/**/*",
      "billing.sqlite"
    ],
    "extraResources": [
      {
        "from": "billing.sqlite",
        "to": "billing.sqlite",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "frontend/public/logo.jpg"
    }
  },
  "keywords": [
    "billing",
    "gst",
    "invoice"
  ],
  "author": "Puspharaj M",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  }
}
